    {
      "id": "bbc7ad45-cae8-4fbb-9315-b25bc3190733",
      "name": "Status result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        1088
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const updated = $input.all().map(i => i.json).filter(r => r && r.id !== undefined);\nif (!updated.length) return [{ json: { status: 404, body: { error: 'candidate not found' } } }];\nreturn [{ json: { status: 200, body: { ok: true } } }];"
      }
    },
    {
      "id": "349e2069-3bb4-4ab1-94db-9fdfdc81f9a7",
      "name": "Validate job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        1360
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const b = $json.body || {};\nconst str = v => (typeof v === 'string' ? v.trim() : (v === undefined || v === null ? '' : String(v).trim()));\nconst slug = s => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);\nconst title = str(b.title);\nif (!title) return { json: { valid: false, status: 400, body: { error: 'title is required' } } };\nconst jobId = slug(str(b.job_id) || title);\nif (!jobId) return { json: { valid: false, status: 400, body: { error: 'job_id could not be built from the title' } } };\nlet crit = b.criteria;\nif (typeof crit === 'string') { try { crit = JSON.parse(crit); } catch (e) { crit = null; } }\nif (!Array.isArray(crit)) return { json: { valid: false, status: 400, body: { error: 'criteria must be a list' } } };\nconst clean = [];\nfor (const c of crit) {\n  const name = str(c && c.name);\n  if (!name) continue;\n  let w = Number(c && c.weight);\n  if (!isFinite(w) || w <= 0) w = 1;\n  w = Math.min(10, Math.round(w));\n  clean.push({ name: name.slice(0, 80), description: str(c && c.description).slice(0, 300), weight: w });\n}\nif (!clean.length) return { json: { valid: false, status: 400, body: { error: 'add at least one criterion with a name' } } };\nconst active = !(b.active === false || b.active === 'false');\nconst kw = str(b.email_keyword) || title;\nreturn { json: { valid: true, job_id: jobId, title: title.slice(0, 100), email_keyword: kw.slice(0, 100), criteria_json: JSON.stringify(clean), criteria: clean, active: active } };"
      }
    },
