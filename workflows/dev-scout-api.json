    {
      "id": "7e0e0a87-1c9b-44af-bab6-435a2342ced4",
      "name": "Build candidates response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        704
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const q = $('Access key').first().json.query || {};\nconst jobId = String(q.job_id || '').trim();\nlet rows = $input.all().map(i => i.json).filter(r => r && r.candidate_id);\nif (jobId) rows = rows.filter(r => r.job_id === jobId);\nconst list = rows.map(r => {\n  let rep = null;\n  try { rep = JSON.parse(r.report); } catch (e) { rep = null; }\n  const cand = (rep && rep.candidate) || {};\n  const skills = Array.isArray(cand.skills) ? cand.skills.slice(0, 5) : [];\n  const strengths = (rep && Array.isArray(rep.strengths)) ? rep.strengths.slice(0, 2) : [];\n  return {\n    candidate_id: r.candidate_id,\n    job_id: r.job_id,\n    name: r.name,\n    email: r.email,\n    phone: r.phone || '',\n    headline: r.headline,\n    github_username: r.github_username,\n    score: (typeof r.score === 'number') ? r.score : null,\n    status: r.status,\n    created_at: r.created_at,\n    top_skills: skills,\n    strengths: strengths\n  };\n});\nlist.sort((a, b) => {\n  const sa = (a.score === null) ? -1 : a.score;\n  const sb = (b.score === null) ? -1 : b.score;\n  return sb - sa;\n});\nreturn [{ json: { status: 200, body: { candidates: list } } }];"
      }
    },
    {
