    {
      "id": "b0bf27a9-c0eb-4018-91cd-d63cfd14572d",
      "name": "Build jobs response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        512
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.job_id);\nconst jobs = rows.map(r => {\n  let criteria = [];\n  try { const p = JSON.parse(r.criteria); if (Array.isArray(p)) criteria = p; } catch (e) { criteria = []; }\n  return { job_id: r.job_id, title: r.title, email_keyword: r.email_keyword || r.title, criteria: criteria, active: r.active === true || r.active === 'true' };\n});\nreturn [{ json: { status: 200, body: { jobs: jobs } } }];"
      }
