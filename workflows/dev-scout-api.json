    {
      "id": "73842158-4a94-4924-8ca9-eaaebeb251df",
      "name": "Build candidate response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        896
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const row = $input.all().map(i => i.json).find(r => r && r.candidate_id);\nif (!row) return [{ json: { status: 404, body: { error: 'candidate not found' } } }];\nlet rep = null;\ntry { rep = JSON.parse(row.report); } catch (e) { rep = null; }\nif (!rep || typeof rep !== 'object') return [{ json: { status: 500, body: { error: 'report could not be read' } } }];\nconst body = Object.assign({}, rep, { email: row.email, phone: row.phone || '', status: row.status });\nreturn [{ json: { status: 200, body: body } }];"
      }
    },
    {
      "id": "e7105630-78ea-4091-a84a-eea52976a0ce",
      "name": "Validate status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        1168
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const b = $json.body || {};\nconst id = String(b.candidate_id || '').trim();\nconst st = String(b.status || '').trim().toLowerCase();\nconst allowed = ['new', 'shortlisted', 'interview', 'rejected'];\nif (!id) return { json: { valid: false, status: 400, body: { error: 'candidate_id is required' } } };\nif (allowed.indexOf(st) === -1) return { json: { valid: false, status: 400, body: { error: 'status must be one of: new, shortlisted, interview, rejected' } } };\nreturn { json: { valid: true, candidate_id: id, new_status: st } };"
      }
    },
